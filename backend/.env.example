# Copy to .env and fill in. Never commit .env.
PORT=5000
MONGO_URI=mongodb://localhost:27017/project-twin

# Origins allowed to call this API, comma-separated.
# Include the deployed frontend as well as the local dev server, e.g.
# http://localhost:5173,https://sanjaycoder48.github.io
CLIENT_URL=http://localhost:5173

# Required. The server refuses to start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: raises GitHub API limits and enables repositories the token can read.
GITHUB_TOKEN=

# Optional: auth attempts allowed per IP per window (default 10 per 15 minutes).
AUTH_RATE_LIMIT_MAX=

# Optional: set when running behind a reverse proxy so rate limiting sees the
# real client IP. Use the number of proxy hops, e.g. 1. Leave unset otherwise.
TRUST_PROXY=
